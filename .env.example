# Discord application credentials (Developer Portal -> your app)
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Public origin of this service, no trailing slash. Every posted link uses it.
PUBLIC_URL=https://your-app.up.railway.app

# From the Railway Redis plugin
REDIS_URL=redis://localhost:6379

# Railway Volume mount path
DATA_DIR=/data

# 2 GB per file
MAX_FILE_BYTES=2147483648
# 4.5 GB total, ~10% under a 5 GB volume
MAX_TOTAL_BYTES=4831838208

PORT=3000
