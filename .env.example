# Discord application credentials (Developer Portal -> your app)
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Public origin of this service, no trailing slash. Every posted link uses it.
PUBLIC_URL=https://your-app.up.railway.app

# From the Railway Redis plugin
REDIS_URL=redis://localhost:6379

# Railway Volume mount path
DATA_DIR=/data

# 300 MB per file on the free plan
MAX_FILE_BYTES=314572800
# 700 MB per file with Premium
PREMIUM_MAX_FILE_BYTES=734003200
# 4.5 GB total, ~10% under a 5 GB volume
MAX_TOTAL_BYTES=4831838208
# 2 GB cap on one uploader's live files
MAX_USER_BYTES=2147483648

# Abuse guards, per Discord user id. 0 disables a given check.
RATE_LIMIT_SESSIONS_PER_HOUR=150
RATE_LIMIT_UPLOADS_PER_HOUR=30

PORT=3000

# Optional: Discord webhook URL for logging command executions. Empty disables.
COMMAND_LOG_WEBHOOK_URL=

# Premium (€1/month) via Stripe. Premium checkout is off unless both are set.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointed at ${PUBLIC_URL}/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional: a pre-created €1/month recurring Price. Empty uses an inline price.
STRIPE_PRICE_ID=
