{
  "name": "discord-uploader",
  "version": "1.0.0",
  "private": true,
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "concurrently -k -n web,server \"chokidar 'web/src/**/*' 'web/adapter/**/*' 'web/astro.config.mjs' -c 'pnpm build:web' --initial\" \"tsx watch --include web/dist/server/entry.mjs src/index.ts\"",
    "build:web": "astro build --root web",
    "build": "pnpm build:web && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "pnpm build:web && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && astro check --root web",
    "e2e:server": "pnpm build:web && tsx test/e2e/server.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "hono": "^4.6.14",
    "ioredis": "^5.4.1",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/busboy": "^1.5.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.5",
    "ioredis-mock": "^8.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
